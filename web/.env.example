# 光圈 · 构图裁剪与自动修图 —— 本地/服务端环境变量(复制为 .env)

# 服务监听
PHOTO_PORT=8791
PHOTO_HOST=127.0.0.1
# 运行期数据目录(会话 / 预设 / AI 配置 / owner token)
PHOTO_DATA_DIR=./data

# 放行访客使用 AI 分析(走站长配的模型);=0 关闭
PHOTO_VISITOR_AI=1

# 大模型经博客 AI 网关(部署时由 compose 注入;本地调试可指向本机主站)
ZX_AI_GATEWAY_URL=http://localhost:3000/api/ai/v1
# 博客 admin「AI 密钥」页签发的本应用令牌(部署必填)
ZX_AI_APP_TOKEN=

# 与博客同一个 SESSION_SECRET:已登录博客即视为站长(SSO)
SESSION_SECRET=

# 站长兜底 token(可选;不填会在数据目录自动生成)
PHOTO_OWNER_TOKEN=
